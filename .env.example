PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_gate
OUTBOUND_ALLOWLIST=
CONNECTOR_TIMEOUT_MS=5000
CONNECTOR_MAX_ATTEMPTS=3

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails that become tenant admins on sign-up. Everyone else starts as viewer.
ADMIN_EMAILS=admin@acme.example
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Demo JWT tokens: on by default outside production. Set false to force real login.
ALLOW_DEMO_AUTH=true

# --- Redis / BullMQ (optional; unset => in-memory rate limit + in-process queue) ---
REDIS_URL=
EXEC_CONCURRENCY=4
EXEC_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=30

# --- Remote MCP: POST {MCP_PUBLIC_URL}; keys map to tenant/role/scopes ---
MCP_PUBLIC_URL=http://localhost:3000/mcp
MCP_CLIENTS=[{"name":"Claude Code","key":"agk_change_me","role":"agent","scopes":["tools:read","tools:email:send"]}]

# --- Tool secrets / RLS / providers / metrics ---
SECRETS_KEY=replace-with-a-long-random-secret
DB_RLS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PROVIDER_ORDER=
METRICS_TOKEN=
