# Agent Gate API configuration.  [R] = required for production, [O] = optional.
# Never commit a real .env; use your platform's secret manager in deployment.

# --- Core ---
PORT=3000                                   # [O]
NODE_ENV=development                        # [R] set to "production" when deployed (disables demo tokens by default)
WEB_ORIGIN=http://localhost:3001            # [R] dashboard origin allowed by CORS / Better Auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_gate   # [R] Supabase/Postgres; unset => in-memory mode
JWT_SECRET=replace-with-a-long-random-secret    # [R] signs demo tokens; also the fallback auth secret
DB_RLS=false                                # [O] true => queries run as role "authenticated" with app.tenant_id (enforces RLS)

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-secret   # [R] >= 32 chars
BETTER_AUTH_URL=http://localhost:3000       # [R] public URL of this API
ADMIN_EMAILS=admin@acme.example             # [R] comma list; these emails become admins at sign-up, everyone else is a viewer
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001  # [O] tenant new users join
ALLOW_DEMO_AUTH=true                        # [R] set false in production (default is false when NODE_ENV=production)
AUTH_AUTO_MIGRATE=true                      # [O] false => run Better Auth migrations yourself

# --- Redis / BullMQ (unset => in-memory rate limits + in-process queue) ---
REDIS_URL=                                  # [R for multi-instance] e.g. redis://localhost:6379 or rediss://...
EXEC_QUEUE=agent-gate-exec                  # [O] BullMQ queue name
EXEC_CONCURRENCY=4                          # [O]
EXEC_ATTEMPTS=3                             # [O] BullMQ retries per approved execution
RATE_LIMIT_PER_MINUTE=30                    # [O] per tenant+identity

# --- Tool connector ---
OUTBOUND_ALLOWLIST=                         # [R to run real tools] comma list of hosts, e.g. api.example.com,hooks.partner.io
CONNECTOR_TIMEOUT_MS=5000                   # [O]
CONNECTOR_MAX_ATTEMPTS=3                    # [O]
SECRETS_KEY=replace-with-a-long-random-secret   # [R to store tool secrets] AES-256-GCM key material; losing it makes stored secrets unreadable

# --- Remote MCP (POST /mcp) ---
MCP_PUBLIC_URL=http://localhost:3000/mcp    # [O] shown in the dashboard / docs
# [O] Static keys managed outside the dashboard (JSON array). Prefer creating keys in the dashboard's "API keys" page.
# MCP_CLIENTS=[{"name":"Claude Code","key":"agk_generate_a_long_random_value","role":"agent","scopes":["tools:read","tools:email:send"]}]
MCP_CLIENTS=

# --- Providers (replay / evaluation). No keys => mock providers ---
ANTHROPIC_API_KEY=                          # [O]
OPENAI_API_KEY=                             # [O]
ANTHROPIC_MODEL=claude-sonnet-5-5           # [O]
OPENAI_MODEL=gpt-4o-mini                    # [O]
PROVIDER_ORDER=                             # [O] e.g. anthropic,openai (fallback order)
PROVIDER_PRICES=                            # [O] JSON {"model":[inputUsdPer1M,outputUsdPer1M]}

# --- Monitoring ---
METRICS_TOKEN=                              # [R in production] Bearer token required by GET /metrics; mirror it in ops/prometheus/metrics_token
